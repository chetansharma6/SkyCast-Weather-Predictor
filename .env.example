# ==============================================================
#  SkyCast — environment template
# ==============================================================
#
#  1. Copy this file to a new file named  .env
#         (Windows PowerShell:  Copy-Item .env.example .env)
#  2. Paste your OpenWeather API key after the "=" below.
#  3. Save.  .env is git-ignored, so your key never leaves
#     this machine.
#
#  Get a free key at: https://home.openweathermap.org/api_keys
# --------------------------------------------------------------

# Your secret OpenWeather API key (required)
OPENWEATHER_API_KEY=your_api_key_here

# Port the SkyCast server listens on (optional, default 8000)
PORT=8000
